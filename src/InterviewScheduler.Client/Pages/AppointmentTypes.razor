@page "/appointment-types"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject IAppointmentTypesApiClient TypesApi
@inject IJSRuntime JSRuntime
@inject IAppNotificationService Notifications

<PageTitle>Appointment Types</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Appointment Types Management</MudText>

<MudGrid>
    <MudItem xs="12" md="8">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Appointment Types</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (appointmentTypes.Any())
                {
                    <MudTable Items="appointmentTypes" Dense="true" Hover="true" Striped="true">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Duration (min)</MudTh>
                            <MudTh>Message Templates</MudTh>
                            <MudTh Style="text-align:right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@context.Name</MudTd>
                            <MudTd DataLabel="Duration">@context.Duration</MudTd>
                            <MudTd DataLabel="Message Templates" Style="max-width: 300px;">
                                <MudText Typo="Typo.caption"><b>Adults:</b></MudText>
                                <MudText Typo="Typo.caption" Class="d-block text-truncate" title="@context.MessageTemplate">@context.MessageTemplate</MudText>
                                <MudText Typo="Typo.caption"><b>Minors:</b></MudText>
                                <MudText Typo="Typo.caption" Class="d-block text-truncate" title="@context.MinorMessageTemplate">@context.MinorMessageTemplate</MudText>
                            </MudTd>
                            <MudTd DataLabel="Actions" Style="text-align:right">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                               OnClick="() => EditAppointmentType(context)" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="() => DeleteAppointmentType(context)" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">No appointment types found. Create one to get started.</MudAlert>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@(editingType == null ? "Add New" : "Edit") Appointment Type</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <EditForm Model="appointmentTypeForm" OnValidSubmit="SaveAppointmentType">
                    <DataAnnotationsValidator />

                    <MudTextField @bind-Value="appointmentTypeForm.Name" For="() => appointmentTypeForm.Name"
                                  Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                    <MudNumericField @bind-Value="appointmentTypeForm.Duration" For="() => appointmentTypeForm.Duration"
                                     Label="Duration (minutes)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Min="5" Max="180" Class="mb-3" />

                    <MudTextField @bind-Value="appointmentTypeForm.MessageTemplate" For="() => appointmentTypeForm.MessageTemplate"
                                  Label="Message Template (Adults)" Variant="Variant.Outlined" Lines="4" Class="mb-1"
                                  HelperText="Placeholders: {ContactName}, {Salutation}, {FirstName}, {MiddleName}, {LastName}, {LeaderName}, {LeaderTitle}, {DateTime}, {Date}, {Day}, {Time}, {Duration}, {AppointmentType}" />

                    <MudTextField @bind-Value="appointmentTypeForm.MinorMessageTemplate" For="() => appointmentTypeForm.MinorMessageTemplate"
                                  Label="Message Template (Minors/Parents)" Variant="Variant.Outlined" Lines="4" Class="mb-3 mt-3"
                                  HelperText="Placeholders: {ContactName}/{ChildName}, {ParentName}, {Salutation}, {FirstName}, {MiddleName}, {LastName}, {LeaderName}, {LeaderTitle}, {DateTime}, {Date}, {Day}, {Time}, {Duration}, {AppointmentType}" />

                    <div class="d-flex gap-2 mt-3">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success">
                            @(editingType == null ? "Add" : "Update")
                        </MudButton>
                        @if (editingType != null)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelEdit">Cancel</MudButton>
                        }
                    </div>
                </EditForm>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2" Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Default Templates</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.caption" Class="mb-2 d-block">Click to use as template:</MudText>
                <MudList T="string">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Groups" OnClick="() => UseTemplate(DefaultTemplates.GenericMeeting)">
                        <MudText Typo="Typo.body2"><b>Generic Meeting</b></MudText>
                        <MudText Typo="Typo.caption">General purpose appointment</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Church" OnClick="() => UseTemplate(DefaultTemplates.TempleRecommend)">
                        <MudText Typo="Typo.body2"><b>Temple Recommend</b></MudText>
                        <MudText Typo="Typo.caption">Temple recommend interview</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Payments" OnClick="() => UseTemplate(DefaultTemplates.Tithing)">
                        <MudText Typo="Typo.body2"><b>Tithing Settlement</b></MudText>
                        <MudText Typo="Typo.caption">Annual tithing settlement</MudText>
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Forum" OnClick="() => UseTemplate(DefaultTemplates.Counseling)">
                        <MudText Typo="Typo.body2"><b>Counseling</b></MudText>
                        <MudText Typo="Typo.caption">Personal counseling session</MudText>
                    </MudListItem>
                </MudList>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private List<AppointmentTypeDto> appointmentTypes = new();
    private AppointmentTypeForm appointmentTypeForm = new();
    private AppointmentTypeDto? editingType;

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointmentTypes();
    }

    private async Task LoadAppointmentTypes()
    {
        appointmentTypes = (await TypesApi.GetAllAsync()).ToList();
    }

    private async Task SaveAppointmentType()
    {
        try
        {
            if (editingType == null)
            {
                var newType = new AppointmentTypeDto
                {
                    Name = appointmentTypeForm.Name,
                    Duration = appointmentTypeForm.Duration,
                    MessageTemplate = appointmentTypeForm.MessageTemplate,
                    MinorMessageTemplate = appointmentTypeForm.MinorMessageTemplate
                };
                await TypesApi.CreateAsync(newType);
            }
            else
            {
                editingType.Name = appointmentTypeForm.Name;
                editingType.Duration = appointmentTypeForm.Duration;
                editingType.MessageTemplate = appointmentTypeForm.MessageTemplate;
                editingType.MinorMessageTemplate = appointmentTypeForm.MinorMessageTemplate;
                await TypesApi.UpdateAsync(editingType.Id, editingType);
            }

            await LoadAppointmentTypes();
            ResetForm();
        }
        catch (Exception ex)
        {
            await Notifications.ShowErrorAsync("Save Appointment Type Failed", $"Error saving appointment type: {ex.Message}");
        }
    }

    private void EditAppointmentType(AppointmentTypeDto type)
    {
        editingType = type;
        appointmentTypeForm = new AppointmentTypeForm
        {
            Name = type.Name,
            Duration = type.Duration,
            MessageTemplate = type.MessageTemplate,
            MinorMessageTemplate = type.MinorMessageTemplate
        };
    }

    private async Task DeleteAppointmentType(AppointmentTypeDto type)
    {
        var confirmed = await Notifications.ConfirmAsync(
            "Delete Appointment Type",
            $"Are you sure you want to delete '{type.Name}'?",
            "Delete");
        if (confirmed)
        {
            await TypesApi.DeleteAsync(type.Id);
            await LoadAppointmentTypes();
        }
    }

    private void CancelEdit()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        editingType = null;
        appointmentTypeForm = new AppointmentTypeForm();
    }

    private void UseTemplate(DefaultTemplate template)
    {
        appointmentTypeForm.Name = template.Name;
        appointmentTypeForm.Duration = template.Duration;
        appointmentTypeForm.MessageTemplate = template.MessageTemplate;
        appointmentTypeForm.MinorMessageTemplate = template.MinorMessageTemplate;
    }

    public class AppointmentTypeForm
    {
        [Required]
        [StringLength(100)]
        public string Name { get; set; } = "";

        [Required]
        [Range(5, 180)]
        public int Duration { get; set; } = 30;

        [Required]
        [StringLength(500)]
        public string MessageTemplate { get; set; } = "";

        [Required]
        [StringLength(500)]
        public string MinorMessageTemplate { get; set; } = "";
    }

    public class DefaultTemplate
    {
        public string Name { get; set; } = "";
        public int Duration { get; set; }
        public string MessageTemplate { get; set; } = "";
        public string MinorMessageTemplate { get; set; } = "";
    }

    public static class DefaultTemplates
    {
        public static DefaultTemplate GenericMeeting => new()
        {
            Name = "Generic Meeting",
            Duration = 30,
            MessageTemplate = "Hello {ContactName}, you have been scheduled for a meeting with {LeaderName} on {DateTime}. Please confirm your attendance.",
            MinorMessageTemplate = "Dear Parent/Guardian of {ContactName}, your child has been scheduled to meet with {LeaderName} on {DateTime}. Please ensure they are available."
        };

        public static DefaultTemplate TempleRecommend => new()
        {
            Name = "Temple Recommend Interview",
            Duration = 20,
            MessageTemplate = "Dear {ContactName}, you have a temple recommend interview scheduled with {LeaderName} on {DateTime}. Please come prepared with any questions you may have.",
            MinorMessageTemplate = "Dear Parent/Guardian of {ContactName}, your child has a temple recommend interview scheduled with {LeaderName} on {DateTime}. Please ensure they attend."
        };

        public static DefaultTemplate Tithing => new()
        {
            Name = "Tithing Settlement",
            Duration = 15,
            MessageTemplate = "Hi {ContactName}, your tithing settlement appointment with {LeaderName} is scheduled for {DateTime}. Please bring your donation records.",
            MinorMessageTemplate = "Dear Parent/Guardian of {ContactName}, your family's tithing settlement with {LeaderName} is scheduled for {DateTime}. Please bring donation records."
        };

        public static DefaultTemplate Counseling => new()
        {
            Name = "Personal Counseling",
            Duration = 45,
            MessageTemplate = "Dear {ContactName}, you have a counseling appointment with {LeaderName} on {DateTime}. This will be a confidential discussion.",
            MinorMessageTemplate = "Dear Parent/Guardian of {ContactName}, your child has a counseling appointment with {LeaderName} on {DateTime}. Please ensure they attend."
        };
    }
}
