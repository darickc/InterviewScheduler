@page "/appointments/new"
@attribute [Authorize]
@using InterviewScheduler.Core.Entities
@using InterviewScheduler.Core.Enums
@using InterviewScheduler.Core.Extensions
@using InterviewScheduler.Core.Helpers
@using Itenso.TimePeriod
@inject IContactsApiClient ContactsApi
@inject ILeadersApiClient LeadersApi
@inject IAppointmentTypesApiClient AppointmentTypesApi
@inject IAppointmentsApiClient AppointmentsApi
@inject IScheduleApiClient ScheduleApi
@inject ISmsService SmsService
@inject ISchedulingRulesService SchedulingRulesService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILogger<AppointmentWizard> Logger

<PageTitle>Schedule Appointment</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Schedule New Appointment</MudText>

<MudCard Elevation="2" Class="mb-4">
    <MudCardContent>
        <MudProgressLinear Color="Color.Primary" Value="@(((currentStep - 1) * 100.0 / 3))" Class="mb-4" Size="Size.Large" Rounded="true" />
        <MudGrid>
            @{
                var steps = new[] { "Select Contacts", "Choose Leaders", "Appointment Details", "Review & Send" };
            }
            @for (var i = 0; i < steps.Length; i++)
            {
                var stepNo = i + 1;
                var stepLabel = steps[i];
                var active = currentStep >= stepNo;
                <MudItem xs="3" Class="d-flex flex-column align-center text-center">
                    <MudAvatar Color="@(active ? Color.Primary : Color.Surface)" Size="Size.Small">@stepNo</MudAvatar>
                    <MudText Typo="Typo.caption" Color="@(active ? Color.Primary : Color.Default)" Class="mt-1">@stepLabel</MudText>
                </MudItem>
            }
        </MudGrid>
    </MudCardContent>
</MudCard>

@if (currentStep == 1)
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent><MudText Typo="Typo.h6">Step 1: Select Contacts</MudText></CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid Class="mb-3" Spacing="2">
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="contactSearchTerm" Immediate="true" Placeholder="Search contacts..."
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="string" @bind-Value="contactGenderFilter" Label="Gender" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem T="string" Value="@("")">All Genders</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Male")">Male</MudSelectItem>
                        <MudSelectItem T="string" Value="@("Female")">Female</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="string" @bind-Value="contactAgeFilter" Label="Age" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        <MudSelectItem T="string" Value="@("")">All Ages</MudSelectItem>
                        <MudSelectItem T="string" Value="@("minor")">Minors (≤17)</MudSelectItem>
                        <MudSelectItem T="string" Value="@("adult")">Adults (18+)</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" GutterBottom="true">Available Contacts</MudText>
                    <MudPaper Outlined="true" Style="max-height: 400px; overflow-y: auto;">
                        <MudList T="string" Dense="true">
                            @foreach (var contact in filteredContacts)
                            {
                                <MudListItem T="string">
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <MudText Typo="Typo.body2"><b>@contact.FullName</b></MudText>
                                            <MudText Typo="Typo.caption">@contact.PhoneNumber • Age: @contact.Age @(contact.IsMinor ? "(Minor)" : "")</MudText>
                                            @if (contact.HeadOfHouse != null)
                                            {
                                                <MudText Typo="Typo.caption" Class="d-block">Head of House: @contact.HeadOfHouse.FullName</MudText>
                                            }
                                        </div>
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => SelectContact(contact)">Select</MudButton>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" GutterBottom="true">Selected Contacts (@selectedContacts.Count)</MudText>
                    @if (selectedContacts.Any())
                    {
                        <MudPaper Outlined="true">
                            <MudList T="string" Dense="true">
                                @foreach (var contact in selectedContacts)
                                {
                                    <MudListItem T="string">
                                        <div class="d-flex justify-space-between align-center">
                                            <div>
                                                <MudText Typo="Typo.body2"><b>@contact.FullName</b></MudText>
                                                <MudText Typo="Typo.caption">@contact.PhoneNumber</MudText>
                                                @if (contact.IsMinor)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">Minor - Parent will be notified</MudChip>
                                                }
                                            </div>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => RemoveContact(contact)">Remove</MudButton>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudPaper>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">No contacts selected</MudText>
                    }
                </MudItem>
            </MudGrid>

            <div class="mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="NextStep" Disabled="@(!selectedContacts.Any())">
                    Next: Choose Leaders
                </MudButton>
            </div>
        </MudCardContent>
    </MudCard>
}
else if (currentStep == 2)
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Step 2: Choose Leaders</MudText>
                <MudText Typo="Typo.body2">Select one or more leaders for scheduling appointments. The system will automatically distribute contacts across available time slots.</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="8">
                    <MudText Typo="Typo.subtitle1" GutterBottom="true">Available Leaders</MudText>
                    <MudGrid>
                        @foreach (var leader in activeLeaders)
                        {
                            var isSelected = selectedLeaders.Contains(leader);
                            <MudItem xs="12" sm="6">
                                <MudCard Outlined="true" Style="@(isSelected ? "border-color: var(--mud-palette-primary); border-width: 2px;" : "")">
                                    <MudCardContent>
                                        <MudText Typo="Typo.subtitle2">@leader.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="d-block mb-2">@leader.Title</MudText>
                                        @if (!string.IsNullOrEmpty(leader.GoogleCalendarId))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Success">
                                                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" /> Calendar Available
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Warning">
                                                <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" /> No Calendar
                                            </MudText>
                                        }
                                    </MudCardContent>
                                    <MudCardActions>
                                        <MudButton Size="Size.Small" Variant="@(isSelected ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
                                                   OnClick="() => ToggleLeader(leader)">
                                            @(isSelected ? "Remove" : "Select")
                                        </MudButton>
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle1" GutterBottom="true">Selected Leaders (@selectedLeaders.Count)</MudText>
                    @if (selectedLeaders.Any())
                    {
                        <MudPaper Outlined="true">
                            <MudList T="string" Dense="true">
                                @foreach (var leader in selectedLeaders)
                                {
                                    <MudListItem T="string">
                                        <div class="d-flex justify-space-between align-center">
                                            <div>
                                                <MudText Typo="Typo.body2"><b>@leader.Name</b></MudText>
                                                <MudText Typo="Typo.caption">@leader.Title</MudText>
                                            </div>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => ToggleLeader(leader)">Remove</MudButton>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        </MudPaper>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">No leaders selected</MudText>
                    }
                </MudItem>
            </MudGrid>

            <div class="mt-4 d-flex gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="PreviousStep">Previous</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward"
                           OnClick="NextStep" Disabled="@(!selectedLeaders.Any())">
                    Next: Appointment Details
                </MudButton>
            </div>
        </MudCardContent>
    </MudCard>
}
else if (currentStep == 3)
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent><MudText Typo="Typo.h6">Step 3: Appointment Details</MudText></CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="int?" @bind-Value="selectedAppointmentTypeId" Label="Appointment Type" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                        @foreach (var type in appointmentTypes)
                        {
                            <MudSelectItem T="int?" Value="@type.Id">@type.Name (@type.Duration minutes)</MudSelectItem>
                        }
                    </MudSelect>

                    @if (selectedAppointmentType != null)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-2">
                            <b>Duration:</b> @selectedAppointmentType.Duration minutes<br />
                            @if (selectedAppointmentType.BufferTimeBeforeMinutes > 0)
                            {
                                <text><b>Buffer Before:</b> @selectedAppointmentType.BufferTimeBeforeMinutes minutes<br /></text>
                            }
                            @if (selectedAppointmentType.BufferTimeAfterMinutes > 0)
                            {
                                <text><b>Buffer After:</b> @selectedAppointmentType.BufferTimeAfterMinutes minutes<br /></text>
                            }
                            <b>Message Template (Adults):</b><br />
                            <small>@selectedAppointmentType.MessageTemplate</small><br /><br />
                            <b>Message Template (Minors/Parents):</b><br />
                            <small>@selectedAppointmentType.MinorMessageTemplate</small>
                        </MudAlert>
                    }
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker Date="AppointmentDateValue" DateChanged="OnAppointmentDateChanged" Label="Appointment Date"
                                   MinDate="DateTime.Today" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                    <MudText Typo="Typo.subtitle2" GutterBottom="true">Time Range</MudText>

                    @if (workingHours?.MorningSession != null)
                    {
                        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                            <MudText Typo="Typo.caption">
                                <b>Working Hours:</b>
                                @workingHours.MorningSession.Start.ToString("HH:mm") - @workingHours.MorningSession.End.ToString("HH:mm")
                            </MudText>
                            @if (workingHours.BreakTimes?.Count > 0)
                            {
                                <div class="mt-1">
                                    <MudText Typo="Typo.caption"><b>Break Times:</b></MudText>
                                    @foreach (var breakTime in workingHours.BreakTimes)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-1">
                                            @breakTime.Start.ToString("HH:mm") - @breakTime.End.ToString("HH:mm")
                                        </MudChip>
                                    }
                                </div>
                            }
                        </MudAlert>
                    }

                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <MudTimePicker Time="StartTimeSpan" TimeChanged="OnStartTimeChanged" Label="Start Time"
                                           AmPm="true" Error="@HasTimeError" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTimePicker Time="EndTimeSpan" TimeChanged="OnEndTimeChanged" Label="End Time"
                                           AmPm="true" Error="@HasTimeError" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>

                    @if (currentValidationResult != null && (!currentValidationResult.IsValid || currentValidationResult.Warnings.Any()))
                    {
                        <div class="mt-2">
                            @foreach (var error in currentValidationResult.Errors)
                            {
                                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-1">@error</MudAlert>
                            }
                            @foreach (var warning in currentValidationResult.Warnings)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-1">@warning</MudAlert>
                            }
                        </div>
                    }

                    @if (showAlternatives && alternativeTimeSlots.Any())
                    {
                        <div class="mt-3">
                            <MudText Typo="Typo.subtitle2" Color="Color.Info" GutterBottom="true">
                                <MudIcon Icon="@Icons.Material.Filled.Lightbulb" Size="Size.Small" /> Alternative Available Times:
                            </MudText>
                            <MudGrid Spacing="1">
                                @foreach (var altSlot in alternativeTimeSlots.Take(6))
                                {
                                    <MudItem xs="6" sm="4">
                                        <MudButton FullWidth="true" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                                   OnClick="() => SelectAlternativeTimeSlot(altSlot)">
                                            @altSlot.Start.ToString("HH:mm") - @altSlot.End.ToString("HH:mm")
                                        </MudButton>
                                    </MudItem>
                                }
                            </MudGrid>
                        </div>
                    }
                </MudItem>
            </MudGrid>

            <div class="mt-4 d-flex gap-2 align-center flex-wrap">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="PreviousStep">Previous</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="NextStep"
                           Disabled="@(selectedAppointmentType == null || appointmentDate == default || startTime == default || endTime == default || !IsStep3Valid())">
                    @if (currentValidationResult != null && !currentValidationResult.IsValid)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                        <span>Fix Validation Issues</span>
                    }
                    else
                    {
                        <span>Next: Review &amp; Send</span>
                    }
                </MudButton>
            </div>
            @if (currentValidationResult != null && currentValidationResult.Warnings.Any() && currentValidationResult.IsValid)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-2 d-block">There are warnings, but you can proceed.</MudText>
            }
        </MudCardContent>
    </MudCard>
}
else if (currentStep == 4)
{
    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent><MudText Typo="Typo.h6">Step 4: Review &amp; Send Notifications</MudText></CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" GutterBottom="true">Appointment Summary</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td><b>Leaders:</b></td><td>@string.Join(", ", selectedLeaders.Select(l => $"{l.Name} ({l.Title})"))</td></tr>
                            <tr><td><b>Type:</b></td><td>@selectedAppointmentType?.Name</td></tr>
                            <tr><td><b>Starting Time:</b></td><td>@appointmentDate.ToString("dddd, MMMM dd, yyyy") at @startTime.ToString("h:mm tt")</td></tr>
                            <tr><td><b>Time Range:</b></td><td>@startTime.ToString("h:mm tt") - @endTime.ToString("h:mm tt")</td></tr>
                            <tr><td><b>Duration per Appointment:</b></td><td>@selectedAppointmentType?.Duration minutes</td></tr>
                            <tr><td><b>Contacts to Schedule:</b></td><td>@selectedContacts.Count contact(s)</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" GutterBottom="true">SMS Messages Preview</MudText>

                    @if (usedFallbackPreview && previewMessages.Any())
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-2">
                            <b>Scheduling Conflicts Detected</b><br />
                            No appointments could be scheduled for the requested time range. The messages below are samples showing what would be sent if scheduling was successful.

                            @if (schedulingConflictReasons.Any())
                            {
                                <div class="mt-2">
                                    <b>Issues found:</b>
                                    <ul class="mb-2">
                                        @foreach (var reason in schedulingConflictReasons.Take(5))
                                        {
                                            <li>@reason</li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (suggestedAlternatives.Any())
                            {
                                <div class="mt-2">
                                    <b>Alternative time slots available today:</b>
                                    <MudGrid Spacing="1" Class="mt-1">
                                        @foreach (var alternative in suggestedAlternatives.Take(4))
                                        {
                                            <MudItem xs="6">
                                                <MudButton FullWidth="true" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                                           OnClick="() => SelectSuggestedTimeRange(alternative)">
                                                    @alternative.Start.ToString("HH:mm") - @alternative.End.ToString("HH:mm")
                                                </MudButton>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </div>
                            }

                            <b>Other options:</b>
                            <ul class="mb-0 mt-1">
                                <li>Adjusting the time range</li>
                                <li>Selecting a different date</li>
                                <li>Adding more leaders</li>
                                <li>Reducing the number of contacts</li>
                            </ul>
                        </MudAlert>
                    }

                    @if (previewMessages.Any())
                    {
                        @foreach (var message in previewMessages)
                        {
                            <MudCard Outlined="true" Class="mb-2">
                                <MudCardContent>
                                    <div class="d-flex justify-space-between align-start">
                                        <div>
                                            <MudText Typo="Typo.subtitle2">@message.ContactName</MudText>
                                            @if (message.IsMinorNotification)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info">Parent Notification</MudChip>
                                            }
                                            @if (usedFallbackPreview)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Sample Message</MudChip>
                                            }
                                        </div>
                                        <MudText Typo="Typo.caption">@message.PhoneNumber</MudText>
                                    </div>
                                    <MudText Typo="Typo.body2" Class="mt-2">@message.Message</MudText>
                                </MudCardContent>
                            </MudCard>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">Message preview will appear here</MudText>
                    }

                    @if (selectedContacts.Any(c => c.IsMinor))
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            <b>Note:</b> A single SMS message will be sent to both parents of minors (if both have phone numbers).
                        </MudAlert>
                    }
                </MudItem>
            </MudGrid>

            <div class="mt-4 d-flex gap-2 align-center flex-wrap">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="PreviousStep">Previous</MudButton>
                <MudButton Variant="Variant.Filled" Color="@(usedFallbackPreview ? Color.Warning : Color.Success)"
                           OnClick="CreateAppointment" Disabled="@isCreatingAppointment">
                    @if (isCreatingAppointment)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @if (usedFallbackPreview)
                    {
                        <span>Attempt to Create Appointments</span>
                    }
                    else
                    {
                        <span>Create Appointment &amp; Send Messages</span>
                    }
                </MudButton>
            </div>
            @if (usedFallbackPreview)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-2 d-block">
                    Warning: Scheduling conflicts detected. The system will attempt to create appointments but some contacts may not be scheduled.
                </MudText>
            }
        </MudCardContent>
    </MudCard>
}

@code {
    private int currentStep = 1;

    private List<Contact> allContacts = new();
    private List<Leader> activeLeaders = new();
    private List<AppointmentType> appointmentTypes = new();
    private List<SmsMessage> previewMessages = new();

    private List<Contact> selectedContacts = new();
    private List<Leader> selectedLeaders = new();

    // Existing appointments scoped to the currently-selected appointmentDate. Refreshed
    // when the user changes the date. Replaces the per-leader DbContext queries the
    // server-side wizard used to issue from inside the scheduling-preview methods.
    private List<Appointment> appointmentsOnDate = new();

    private bool usedFallbackPreview = false;
    private List<string> schedulingConflictReasons = new();
    private List<TimeRange> suggestedAlternatives = new();

    private string contactSearchTerm = "";
    private string contactGenderFilter = "";
    private string contactAgeFilter = "";

    private int? selectedAppointmentTypeId;
    private DateTime appointmentDate = GetNextSunday();
    private TimeOnly startTime = new TimeOnly(9, 0);
    private TimeOnly endTime = new TimeOnly(17, 0);

    private bool isCreatingAppointment = false;

    private WorkingHours workingHours = new();
    private ValidationResult currentValidationResult = new();
    private List<TimeRange> alternativeTimeSlots = new();
    private bool showAlternatives = false;

    // MudDatePicker.Date is DateTime? and MudTimePicker.Time is TimeSpan?; adapt to the
    // existing DateTime / TimeOnly fields so the rest of the scheduling code is unchanged.
    private DateTime? AppointmentDateValue => appointmentDate;
    private TimeSpan? StartTimeSpan => startTime.ToTimeSpan();
    private TimeSpan? EndTimeSpan => endTime.ToTimeSpan();
    private bool HasTimeError => currentValidationResult is { IsValid: false } && currentValidationResult.Errors.Any();

    private async Task OnAppointmentDateChanged(DateTime? value)
    {
        appointmentDate = value?.Date ?? appointmentDate;
        await OnDateChanged();
    }

    private async Task OnStartTimeChanged(TimeSpan? value)
    {
        startTime = value.HasValue ? TimeOnly.FromTimeSpan(value.Value) : default;
        await OnTimeRangeChanged();
    }

    private async Task OnEndTimeChanged(TimeSpan? value)
    {
        endTime = value.HasValue ? TimeOnly.FromTimeSpan(value.Value) : default;
        await OnTimeRangeChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        LoadSchedulingConfiguration();
        await RefreshAppointmentsForDate();
    }

    private async Task LoadData()
    {
        var contactsTask = ContactsApi.GetAllAsync();
        var leadersTask = LeadersApi.GetAllAsync();
        var typesTask = AppointmentTypesApi.GetAllAsync();

        await Task.WhenAll(contactsTask, leadersTask, typesTask);

        var contactsById = (await contactsTask).ToContactGraph();
        allContacts = contactsById.Values
            .OrderBy(c => c.LastName)
            .ThenBy(c => c.FirstName)
            .ToList();

        activeLeaders = (await leadersTask)
            .Where(l => l.IsActive)
            .Select(l => l.ToLeader())
            .OrderBy(l => l.Title)
            .ToList();

        appointmentTypes = (await typesTask)
            .Select(t => t.ToAppointmentType())
            .OrderBy(t => t.Name)
            .ToList();
    }

    private async Task RefreshAppointmentsForDate()
    {
        try
        {
            var dayStart = appointmentDate.Date;
            var dayEnd = dayStart.AddDays(1);

            var apptDtos = await AppointmentsApi.GetAllAsync(from: dayStart, to: dayEnd);
            var contactsById = allContacts.ToDictionary(c => c.Id, c => c);
            var leadersById = activeLeaders.ToDictionary(l => l.Id, l => l);
            var typesById = appointmentTypes.ToDictionary(t => t.Id, t => t);

            appointmentsOnDate = apptDtos
                .Select(d => d.ToAppointment(contactsById, leadersById, typesById))
                .Where(a => a != null)
                .Cast<Appointment>()
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading appointments for {Date}", appointmentDate.ToString("yyyy-MM-dd"));
            appointmentsOnDate = new List<Appointment>();
        }
    }

    private async Task OnDateChanged()
    {
        await RefreshAppointmentsForDate();
        await ValidateCurrentTimeRange();
    }

    private void LoadSchedulingConfiguration()
    {
        try
        {
            workingHours = SchedulingRulesService.GetDefaultWorkingHours();
            currentValidationResult = new ValidationResult();
            alternativeTimeSlots.Clear();
            showAlternatives = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load scheduling configuration");
            workingHours = new WorkingHours
            {
                MorningSession = new TimeRange(DateTime.Today.Add(new TimeSpan(9, 0, 0)), DateTime.Today.Add(new TimeSpan(17, 0, 0))),
                BreakTimes = new TimePeriodCollection()
            };
        }
    }

    private IEnumerable<Contact> filteredContacts
    {
        get
        {
            var filtered = allContacts.Where(c => !selectedContacts.Contains(c));

            if (!string.IsNullOrWhiteSpace(contactSearchTerm))
            {
                filtered = filtered.Where(c =>
                    c.FirstName.Contains(contactSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(c.MiddleName) && c.MiddleName.Contains(contactSearchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    c.LastName.Contains(contactSearchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (c.PhoneNumber != null && c.PhoneNumber.Contains(contactSearchTerm)));
            }

            if (!string.IsNullOrWhiteSpace(contactGenderFilter))
            {
                filtered = filtered.Where(c => c.Gender.ToString() == contactGenderFilter);
            }

            if (!string.IsNullOrWhiteSpace(contactAgeFilter))
            {
                filtered = contactAgeFilter switch
                {
                    "minor" => filtered.Where(c => c.IsMinor),
                    "adult" => filtered.Where(c => !c.IsMinor),
                    _ => filtered
                };
            }

            return filtered;
        }
    }

    private AppointmentType? selectedAppointmentType =>
        selectedAppointmentTypeId.HasValue ? appointmentTypes.FirstOrDefault(t => t.Id == selectedAppointmentTypeId.Value) : null;

    private bool IsStep3Valid() => currentValidationResult == null || currentValidationResult.IsValid;

    private static DateTime GetNextSunday()
    {
        var today = DateTime.Today;
        var daysUntilSunday = ((int)DayOfWeek.Sunday - (int)today.DayOfWeek + 7) % 7;
        return daysUntilSunday == 0 ? today.AddDays(7) : today.AddDays(daysUntilSunday);
    }

    private Task OnTimeRangeChanged() => ValidateCurrentTimeRange();

    private Task ValidateCurrentTimeRange()
    {
        currentValidationResult = new ValidationResult();
        alternativeTimeSlots.Clear();
        showAlternatives = false;

        if (selectedAppointmentType == null || !selectedLeaders.Any())
            return Task.CompletedTask;

        try
        {
            var proposedStartTime = appointmentDate.Date.Add(startTime.ToTimeSpan());
            var proposedEndTime = appointmentDate.Date.Add(endTime.ToTimeSpan());

            if (proposedStartTime >= proposedEndTime)
            {
                currentValidationResult.AddError("Start time must be before end time");
                return Task.CompletedTask;
            }

            if (proposedStartTime < DateTime.Now)
            {
                currentValidationResult.AddError("Cannot schedule appointments in the past");
                return Task.CompletedTask;
            }

            var timeRangeDuration = (proposedEndTime - proposedStartTime).TotalMinutes;
            var appointmentDuration = selectedAppointmentType.Duration;

            if (timeRangeDuration < appointmentDuration)
            {
                currentValidationResult.AddError($"Time range ({timeRangeDuration:F0} minutes) is too short for a {appointmentDuration}-minute appointment");
                return Task.CompletedTask;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error validating time range");
            currentValidationResult.AddError("Error validating time range");
        }

        return Task.CompletedTask;
    }

    private void SelectAlternativeTimeSlot(TimeRange timeSlot)
    {
        startTime = TimeOnly.FromDateTime(timeSlot.Start);
        endTime = TimeOnly.FromDateTime(timeSlot.End);
        showAlternatives = false;
        _ = ValidateCurrentTimeRange();
    }

    private async Task SelectSuggestedTimeRange(TimeRange timeRange)
    {
        startTime = TimeOnly.FromDateTime(timeRange.Start);
        endTime = TimeOnly.FromDateTime(timeRange.End);
        usedFallbackPreview = false;
        schedulingConflictReasons.Clear();
        suggestedAlternatives.Clear();
        await GenerateSmsPreview();
    }

    private async Task NextStep()
    {
        if (currentStep == 2)
        {
            await ValidateCurrentTimeRange();
        }
        else if (currentStep == 3)
        {
            await GenerateSmsPreview();
        }
        currentStep++;
    }

    private void PreviousStep() => currentStep--;

    private void SelectContact(Contact contact) => selectedContacts.Add(contact);
    private void RemoveContact(Contact contact) => selectedContacts.Remove(contact);

    private void ToggleLeader(Leader leader)
    {
        if (selectedLeaders.Contains(leader))
            selectedLeaders.Remove(leader);
        else
            selectedLeaders.Add(leader);
    }

    private async Task GenerateSmsPreview()
    {
        if (selectedContacts.Count == 0 || !selectedLeaders.Any() || selectedAppointmentType == null)
        {
            previewMessages = new List<SmsMessage>();
            return;
        }

        previewMessages = await GenerateAutoSchedulePreview();
    }

    private Task<List<SmsMessage>> GenerateAutoSchedulePreview()
    {
        var messages = new List<SmsMessage>();
        var scheduledAppointments = GenerateEnhancedSchedulePlan();

        if (scheduledAppointments.Any())
        {
            usedFallbackPreview = false;
            foreach (var scheduled in scheduledAppointments)
            {
                var contact = selectedContacts.First(c => c.Id == scheduled.ContactId);
                var leader = selectedLeaders.First(l => l.Id == scheduled.LeaderId);

                var contactMessages = SmsService.GenerateAppointmentMessages(
                    new List<Contact> { contact },
                    leader,
                    selectedAppointmentType!,
                    scheduled.ScheduledTime);

                messages.AddRange(contactMessages);
            }
        }
        else
        {
            usedFallbackPreview = true;
            schedulingConflictReasons = AnalyzeSchedulingConflicts();
            suggestedAlternatives = GenerateSuggestedAlternatives();

            if (selectedContacts.Any() && selectedLeaders.Any() && selectedAppointmentType != null)
            {
                var sampleStartTime = appointmentDate.Date.Add(startTime.ToTimeSpan());
                var firstContact = selectedContacts.First();
                var firstLeader = selectedLeaders.First();

                var fallbackMessages = SmsService.GenerateAppointmentMessages(
                    new List<Contact> { firstContact },
                    firstLeader,
                    selectedAppointmentType,
                    sampleStartTime);

                foreach (var msg in fallbackMessages)
                {
                    msg.Message = "[SAMPLE] " + msg.Message;
                }

                messages.AddRange(fallbackMessages);
            }
        }

        return Task.FromResult(messages);
    }

    private List<ScheduledAppointment> GenerateEnhancedSchedulePlan()
    {
        var plan = new List<ScheduledAppointment>();

        if (selectedAppointmentType == null || !selectedLeaders.Any() || !selectedContacts.Any())
            return plan;

        var requestedStartTime = appointmentDate.Date.Add(startTime.ToTimeSpan());
        var requestedEndTime = appointmentDate.Date.Add(endTime.ToTimeSpan());

        try
        {
            var timeSlotDuration = selectedAppointmentType.Duration;
            var scheduledTimes = new HashSet<(int leaderId, DateTime time)>();
            var unscheduledContacts = new List<string>();

            foreach (var contact in selectedContacts)
            {
                var assigned = false;

                foreach (var leader in selectedLeaders)
                {
                    var existingAppointments = appointmentsOnDate
                        .Where(a => a.LeaderId == leader.Id)
                        .ToList();

                    var availableSlots = SchedulingRulesService.GetAvailableSlots(
                        appointmentDate, selectedAppointmentType, leader.Id, existingAppointments, workingHours);

                    var filteredSlots = availableSlots
                        .Where(slot =>
                        {
                            var appointmentEnd = slot.Start.AddMinutes(timeSlotDuration);
                            return slot.Start >= requestedStartTime && appointmentEnd <= requestedEndTime;
                        })
                        .OrderBy(slot => slot.Start)
                        .ToList();

                    foreach (var slot in filteredSlots)
                    {
                        var slotKey = (leader.Id, slot.Start);

                        if (!scheduledTimes.Contains(slotKey))
                        {
                            plan.Add(new ScheduledAppointment
                            {
                                ContactId = contact.Id,
                                LeaderId = leader.Id,
                                ScheduledTime = slot.Start
                            });

                            scheduledTimes.Add(slotKey);
                            assigned = true;
                            break;
                        }
                    }

                    if (assigned) break;
                }

                if (!assigned)
                {
                    unscheduledContacts.Add(contact.FullName);
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating enhanced schedule plan");
        }

        return plan;
    }

    private class ScheduledAppointment
    {
        public int ContactId { get; set; }
        public int LeaderId { get; set; }
        public DateTime ScheduledTime { get; set; }
    }

    private async Task CreateAppointment()
    {
        if (selectedContacts.Count == 0 || !selectedLeaders.Any() || selectedAppointmentType == null)
            return;

        isCreatingAppointment = true;
        try
        {
            var request = new CreateScheduleRequest
            {
                Date = appointmentDate,
                StartTime = startTime,
                EndTime = endTime,
                AppointmentTypeId = selectedAppointmentType.Id,
                LeaderIds = selectedLeaders.Select(l => l.Id).ToList(),
                ContactIds = selectedContacts.Select(c => c.Id).ToList()
            };

            var result = await ScheduleApi.CreateAsync(request);

            var message = $"Automatic scheduling completed!\n\n";
            message += $"✅ {result.AppointmentsCreated} appointments created\n";
            message += $"📅 {result.CalendarEventsCreated} calendar events created\n";

            if (result.UnscheduledContacts.Any())
            {
                message += $"\n⚠️ Could not schedule {result.UnscheduledContacts.Count} contact(s):\n";
                message += string.Join("\n", result.UnscheduledContacts);
                message += "\n\nPlease try:\n- Selecting a different time range\n- Adding more leaders\n- Choosing a different date";
            }
            else
            {
                message += "\n🎉 All contacts successfully scheduled!";
            }

            await JSRuntime.InvokeVoidAsync("alert", message);
            Navigation.NavigateTo("/appointments");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error creating appointments: {ex.Message}");
        }
        finally
        {
            isCreatingAppointment = false;
        }
    }

    private List<string> AnalyzeSchedulingConflicts()
    {
        var reasons = new List<string>();

        if (selectedAppointmentType == null || !selectedLeaders.Any() || !selectedContacts.Any())
            return reasons;

        var requestedStartTime = appointmentDate.Date.Add(startTime.ToTimeSpan());
        var requestedEndTime = appointmentDate.Date.Add(endTime.ToTimeSpan());
        var timeRangeDuration = (requestedEndTime - requestedStartTime).TotalMinutes;
        var appointmentDuration = selectedAppointmentType.Duration;

        if (timeRangeDuration < appointmentDuration)
        {
            reasons.Add($"Time range ({timeRangeDuration:F0} min) too short for {appointmentDuration}-min appointments");
            return reasons;
        }

        var totalAvailableSlots = 0;
        var leadersWithNoSlots = 0;

        foreach (var leader in selectedLeaders)
        {
            var existingAppointments = appointmentsOnDate
                .Where(a => a.LeaderId == leader.Id)
                .ToList();

            var availableSlots = SchedulingRulesService.GetAvailableSlots(
                appointmentDate, selectedAppointmentType, leader.Id, existingAppointments, workingHours);

            var filteredSlots = availableSlots
                .Where(slot => slot.Start >= requestedStartTime && slot.Start.AddMinutes(appointmentDuration) <= requestedEndTime)
                .ToList();

            totalAvailableSlots += filteredSlots.Count;

            if (filteredSlots.Count == 0)
            {
                leadersWithNoSlots++;

                if (existingAppointments.Any())
                {
                    reasons.Add($"{leader.Name}: has {existingAppointments.Count} existing appointments on this date");
                }

                if (availableSlots.Count > 0 && filteredSlots.Count == 0)
                {
                    reasons.Add($"{leader.Name}: available slots fall outside requested time range");
                }
            }
        }

        if (totalAvailableSlots < selectedContacts.Count)
        {
            reasons.Add($"Only {totalAvailableSlots} available slots for {selectedContacts.Count} contacts");
        }

        if (leadersWithNoSlots == selectedLeaders.Count)
        {
            reasons.Add("No leaders have availability in the requested time range");
        }

        return reasons.Distinct().ToList();
    }

    private List<TimeRange> GenerateSuggestedAlternatives()
    {
        var alternatives = new List<TimeRange>();

        if (selectedAppointmentType == null || !selectedLeaders.Any())
            return alternatives;

        var requestedDuration = (endTime.ToTimeSpan() - startTime.ToTimeSpan()).TotalMinutes;

        foreach (var leader in selectedLeaders.Take(2))
        {
            var existingAppointments = appointmentsOnDate
                .Where(a => a.LeaderId == leader.Id)
                .ToList();

            var availableSlots = SchedulingRulesService.GetAvailableSlots(
                appointmentDate, selectedAppointmentType, leader.Id, existingAppointments, workingHours);

            foreach (var slot in availableSlots.Take(10))
            {
                var slotDuration = (slot.End - slot.Start).TotalMinutes;
                if (slotDuration >= requestedDuration)
                {
                    var suggestedEnd = slot.Start.AddMinutes(requestedDuration);
                    if (suggestedEnd <= slot.End)
                    {
                        alternatives.Add(new TimeRange(slot.Start, suggestedEnd));
                    }
                }
            }
        }

        return alternatives
            .GroupBy(alt => new { alt.Start, alt.End })
            .Select(g => g.First())
            .OrderBy(alt => alt.Start)
            .Take(6)
            .ToList();
    }
