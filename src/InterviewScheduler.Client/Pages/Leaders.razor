@page "/leaders"
@attribute [Authorize]
@inject ILeadersApiClient LeadersApi
@inject NavigationManager Navigation

<PageTitle>Leaders</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Leader Management</MudText>

<MudGrid>
    <MudItem xs="12" md="8" Class="d-flex align-center">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="ShowAddLeader">
            Add New Leader
        </MudButton>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Google Calendar Integration</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (isCalendarAuthenticated)
                {
                    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">Connected to Google Calendar</MudAlert>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="ClearCredentials">
                        Disconnect
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">Not connected to Google Calendar</MudAlert>
                    <div class="d-flex gap-2 flex-wrap">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="AuthorizeGoogleCalendar">
                            Connect Google Calendar
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="ClearCredentials">
                            Clear Cached Credentials
                        </MudButton>
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@if (showForm)
{
    <MudCard Elevation="2" Class="my-4">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">@(editingLeader == null ? "Add New Leader" : "Edit Leader")</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <EditForm Model="@currentLeader" OnValidSubmit="@SaveLeader">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="currentLeader.Name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

                <MudSelect T="string" @bind-Value="currentLeader.Title" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    <MudSelectItem T="string" Value="@("Bishop")">Bishop</MudSelectItem>
                    <MudSelectItem T="string" Value="@("1st Counselor")">1st Counselor</MudSelectItem>
                    <MudSelectItem T="string" Value="@("2nd Counselor")">2nd Counselor</MudSelectItem>
                </MudSelect>

                @if (isCalendarAuthenticated && availableCalendars.Any())
                {
                    <MudSelect T="string" @bind-Value="currentLeader.GoogleCalendarId" Label="Google Calendar"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                               HelperText="Select the Google Calendar for this leader">
                        @foreach (var calendar in availableCalendars)
                        {
                            <MudSelectItem T="string" Value="@calendar.Id">@calendar.Name @(calendar.IsPrimary ? "(Primary)" : "")</MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (isCalendarAuthenticated)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">No calendars found. Please check your Google Calendar access.</MudAlert>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="LoadCalendars" Class="mb-3">
                        Refresh Calendars
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">Please connect to Google Calendar first</MudAlert>
                    <MudTextField @bind-Value="currentLeader.GoogleCalendarId" Label="Calendar ID" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Placeholder="Or enter calendar ID manually" Class="mb-3"
                                  HelperText="You can enter a calendar ID manually if not connected" />
                }

                <MudCheckBox T="bool" @bind-Value="currentLeader.IsActive" Label="Active" Color="Color.Primary" Class="mb-3" />

                <div class="d-flex gap-2">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Success">Save</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="CancelEdit">Cancel</MudButton>
                </div>
            </EditForm>
        </MudCardContent>
    </MudCard>
}

<MudText Typo="Typo.h5" GutterBottom="true" Class="mt-4">Current Leaders</MudText>

@if (leaders.Any())
{
    <MudTable Items="leaders" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Title</MudTh>
            <MudTh>Google Calendar ID</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Google Calendar ID">@context.GoogleCalendarId</MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Inactive</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => EditLeader(context)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => DeleteLeader(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">No leaders configured yet.</MudAlert>
}

@code {
    private List<LeaderDto> leaders = new();
    private LeaderDto currentLeader = new() { IsActive = true };
    private LeaderDto? editingLeader;
    private bool showForm = false;
    private bool isCalendarAuthenticated = false;
    private List<CalendarInfoDto> availableCalendars = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaders();
        await LoadCalendars();
    }

    private async Task LoadLeaders()
    {
        leaders = (await LeadersApi.GetAllAsync()).ToList();
    }

    private async Task LoadCalendars()
    {
        // The calendar API returns the user's Google calendars when their access token is
        // still valid. Treat a successful response as "connected"; treat any failure as a
        // signal that the user needs to re-auth.
        try
        {
            availableCalendars = (await LeadersApi.GetCalendarsAsync()).ToList();
            isCalendarAuthenticated = true;
        }
        catch
        {
            availableCalendars = new List<CalendarInfoDto>();
            isCalendarAuthenticated = false;
        }
    }

    private void ShowAddLeader()
    {
        currentLeader = new LeaderDto { IsActive = true };
        editingLeader = null;
        showForm = true;
    }

    private void EditLeader(LeaderDto leader)
    {
        currentLeader = new LeaderDto
        {
            Id = leader.Id,
            Name = leader.Name,
            Title = leader.Title,
            GoogleCalendarId = leader.GoogleCalendarId,
            IsActive = leader.IsActive
        };
        editingLeader = leader;
        showForm = true;
    }

    private async Task SaveLeader()
    {
        if (editingLeader == null)
            await LeadersApi.CreateAsync(currentLeader);
        else
            await LeadersApi.UpdateAsync(editingLeader.Id, currentLeader);

        await LoadLeaders();
        CancelEdit();
    }

    private async Task DeleteLeader(LeaderDto leader)
    {
        await LeadersApi.DeleteAsync(leader.Id);
        await LoadLeaders();
    }

    private void CancelEdit()
    {
        showForm = false;
        currentLeader = new LeaderDto { IsActive = true };
        editingLeader = null;
    }

    private void AuthorizeGoogleCalendar()
    {
        // forceLoad triggers a real browser navigation to the server-rendered Google
        // OAuth challenge endpoint. WASM cannot handle /signin-google in-process.
        Navigation.NavigateTo("/signin-google", forceLoad: true);
    }

    private void ClearCredentials()
    {
        availableCalendars.Clear();
        Navigation.NavigateTo("/signout-google", forceLoad: true);
    }
}
