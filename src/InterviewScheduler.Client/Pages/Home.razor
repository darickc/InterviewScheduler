@page "/"
@attribute [AllowAnonymous]

<PageTitle>Interview Scheduler</PageTitle>

<MudText Typo="Typo.h3" Align="Align.Center" GutterBottom="true" Class="mb-6">Interview Scheduler</MudText>

<AuthorizeView>
    <Authorized>
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-6">
            <MudText Typo="Typo.h6">Welcome back, @context.User.Identity?.Name!</MudText>
            <MudText Typo="Typo.body2">You are signed in and have access to all features.</MudText>
        </MudAlert>

        <MudGrid>
            @foreach (var link in QuickLinks)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="2" Class="h-100 d-flex flex-column">
                        <MudCardContent Class="flex-grow-1">
                            <div class="d-flex align-center mb-2">
                                <MudIcon Icon="@link.Icon" Color="Color.Primary" Class="mr-2" />
                                <MudText Typo="Typo.h6">@link.Title</MudText>
                            </div>
                            <MudText Typo="Typo.body2">@link.Description</MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@link.Href">@link.LinkText</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">
            Welcome to the Interview Scheduler application. This system helps manage interview appointments, contacts, and schedules.
        </MudText>

        <MudContainer MaxWidth="MaxWidth.Small">
            <MudCard Elevation="3" Class="mb-8">
                <MudCardContent>
                    <div class="d-flex flex-column align-center text-center pa-2">
                        <MudText Typo="Typo.h6" GutterBottom="true">Sign In Required</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">Please sign in to access the Interview Scheduler features.</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                                   StartIcon="@Icons.Custom.Brands.Google" Href="/signin-google">
                            Sign in with Google
                        </MudButton>
                    </div>
                </MudCardContent>
            </MudCard>
        </MudContainer>

        <MudText Typo="Typo.h5" Align="Align.Center" GutterBottom="true">Features</MudText>
        <MudList T="string" Class="mx-auto" Style="max-width: 500px;">
            @foreach (var feature in Features)
            {
                <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success" Text="@feature" />
            }
        </MudList>
    </NotAuthorized>
</AuthorizeView>

@code {
    private record QuickLink(string Title, string Description, string Href, string LinkText, string Icon);

    private static readonly QuickLink[] QuickLinks =
    [
        new("Appointments", "Manage interview appointments and schedules.", "/appointments", "View Appointments", Icons.Material.Filled.Event),
        new("Contacts", "Manage candidate and interviewer contacts.", "/contacts", "View Contacts", Icons.Material.Filled.People),
        new("Leaders", "Manage interviewers and their availability.", "/leaders", "View Leaders", Icons.Material.Filled.AdminPanelSettings),
        new("Appointment Types", "Configure different types of appointments.", "/appointment-types", "View Types", Icons.Material.Filled.Checklist),
        new("SMS Preview", "Preview and send SMS notifications.", "/sms-preview", "Open SMS Preview", Icons.Material.Filled.Sms),
    ];

    private static readonly string[] Features =
    [
        "Schedule and manage interview appointments",
        "Track candidate and interviewer contacts",
        "Manage interviewer availability",
        "Send SMS notifications and reminders",
        "Google Calendar integration",
    ];
}
