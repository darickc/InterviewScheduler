@page "/sms-preview"
@attribute [Authorize]
@using InterviewScheduler.Core.Entities
@inject IContactsApiClient ContactsApi
@inject ILeadersApiClient LeadersApi
@inject IAppointmentTypesApiClient AppointmentTypesApi
@inject ISmsService SmsService
@inject IJSRuntime JSRuntime
@inject IAppNotificationService Notifications

<PageTitle>SMS Preview</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">SMS Link Generator &amp; Preview</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudCard Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Test SMS Generator</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudSelect T="int?" @bind-Value="selectedContactId" Label="Contact" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Clearable="true">
                    @foreach (var contact in contacts)
                    {
                        <MudSelectItem T="int?" Value="@contact.Id">
                            @contact.Salutation @contact.FullName
                            @if (!string.IsNullOrEmpty(contact.PhoneNumber))
                            {
                                <text> (@contact.PhoneNumber)</text>
                            }
                            else if (contact.IsMinor && contact.HeadOfHouse != null && !string.IsNullOrEmpty(contact.HeadOfHouse.PhoneNumber))
                            {
                                <text> (Minor - Parent: @contact.HeadOfHouse.PhoneNumber)</text>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int?" @bind-Value="selectedLeaderId" Label="Leader" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Clearable="true">
                    @foreach (var leader in leaders)
                    {
                        <MudSelectItem T="int?" Value="@leader.Id">@leader.Name (@leader.Title)</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="int?" @bind-Value="selectedAppointmentTypeId" Label="Appointment Type" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Clearable="true">
                    @foreach (var type in appointmentTypes)
                    {
                        <MudSelectItem T="int?" Value="@type.Id">@type.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="7">
                        <MudDatePicker @bind-Date="apptDate" Label="Appointment Date" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="5">
                        <MudTimePicker @bind-Time="apptTime" Label="Time" Variant="Variant.Outlined" Margin="Margin.Dense" AmPm="true" />
                    </MudItem>
                </MudGrid>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Preview"
                           OnClick="GeneratePreview"
                           Disabled="@(selectedContact == null || selectedLeader == null || selectedAppointmentType == null)">
                    Generate SMS Preview
                </MudButton>
            </MudCardContent>
        </MudCard>

        <MudCard Elevation="2" Class="mt-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Phone Number Validator</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="testPhoneNumber" Immediate="true" Label="Test Phone Number" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Placeholder="Enter phone number or multiple numbers separated by comma"
                              HelperText='You can test multiple numbers by separating with commas (e.g., "555-1234, 555-5678")' />

                @if (!string.IsNullOrWhiteSpace(testPhoneNumber))
                {
                    <MudGrid Class="mt-2">
                        <MudItem xs="12" sm="6"><MudText Typo="Typo.body2"><b>Original:</b> @testPhoneNumber</MudText></MudItem>
                        <MudItem xs="12" sm="6"><MudText Typo="Typo.body2"><b>Sanitized:</b> @SmsService.SanitizePhoneNumbers(testPhoneNumber)</MudText></MudItem>
                    </MudGrid>
                    <div class="mt-2">
                        @if (SmsService.IsValidPhoneNumber(testPhoneNumber))
                        {
                            <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">Valid Phone Number</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Cancel">Invalid Phone Number</MudChip>
                        }
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="6">
        @if (generatedMessages.Any())
        {
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Generated SMS Messages (@generatedMessages.Count)</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @foreach (var message in generatedMessages)
                    {
                        <MudCard Outlined="true" Class="mb-3">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <div class="d-flex justify-space-between align-center">
                                        <span>
                                            <b>@message.ContactName</b>
                                            @if (message.IsMinorNotification)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">Parent Notification</MudChip>
                                            }
                                        </span>
                                        <MudText Typo="Typo.caption">@message.PhoneNumber</MudText>
                                    </div>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <MudText Typo="Typo.body2" Class="mb-3">@message.Message</MudText>

                                <div class="d-flex gap-2 flex-wrap">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="() => CopyToClipboard(message.Message)">
                                        Copy Message
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.Smartphone" OnClick="() => OpenSmsLink(message.SmsLink)">
                                        Open SMS App
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                                               StartIcon="@Icons.Material.Filled.Link" OnClick="() => CopyToClipboard(message.SmsLink)">
                                        Copy SMS Link
                                    </MudButton>
                                </div>

                                <MudExpansionPanels Class="mt-2" Elevation="0">
                                    <MudExpansionPanel Text="Show SMS Link">
                                        <MudText Typo="Typo.caption" Style="word-break: break-all;">@message.SmsLink</MudText>
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            </MudCardContent>
                        </MudCard>
                    }
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <MudPaper Elevation="2" Class="pa-8 d-flex flex-column align-center justify-center" Style="min-height: 200px;">
                <MudIcon Icon="@Icons.Material.Filled.Sms" Size="Size.Large" Color="Color.Default" />
                <MudText Typo="Typo.h6" Class="mt-3">No Messages Generated</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center">Select contact, leader, and appointment details to generate SMS preview</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<MudCard Elevation="2" Class="mt-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">SMS Link Format Information</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">Supported Formats</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string"><code>sms:+1234567890?body=message</code> - Standard SMS URI</MudListItem>
                    <MudListItem T="string"><code>sms:+1234567890,+1234567891?body=message</code> - Multiple recipients</MudListItem>
                    <MudListItem T="string"><code>sms:+1234567890&body=message</code> - Alternative format</MudListItem>
                    <MudListItem T="string">Works with most mobile devices and SMS apps</MudListItem>
                    <MudListItem T="string">Message content is URL-encoded for safety</MudListItem>
                    <MudListItem T="string">Multiple recipients are comma-separated</MudListItem>
                </MudList>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" GutterBottom="true">Phone Number Processing</MudText>
                <MudList T="string" Dense="true">
                    <MudListItem T="string">Automatically adds +1 for US numbers</MudListItem>
                    <MudListItem T="string">Removes formatting characters (spaces, dashes, parentheses)</MudListItem>
                    <MudListItem T="string">Validates against US and international formats</MudListItem>
                    <MudListItem T="string">Supports 10-digit US numbers and international format</MudListItem>
                </MudList>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.subtitle1" GutterBottom="true" Class="mt-4">Message Template Variables</MudText>
        <MudSimpleTable Dense="true" Hover="true" Striped="true">
            <thead>
                <tr><th>Variable</th><th>Description</th><th>Example</th></tr>
            </thead>
            <tbody>
                <tr><td><code>{ContactName}</code></td><td>Contact's salutation and full name</td><td>Brother John Smith</td></tr>
                <tr><td><code>{LeaderName}</code></td><td>Leader's name</td><td>Bishop Johnson</td></tr>
                <tr><td><code>{LeaderTitle}</code></td><td>Leader's title</td><td>Bishop</td></tr>
                <tr><td><code>{DateTime}</code></td><td>Full date and time</td><td>Monday, January 15 at 2:00 PM</td></tr>
                <tr><td><code>{Date}</code></td><td>Date only</td><td>Monday, January 15</td></tr>
                <tr><td><code>{Time}</code></td><td>Time only</td><td>2:00 PM</td></tr>
                <tr><td><code>{Duration}</code></td><td>Appointment duration in minutes</td><td>30</td></tr>
                <tr><td><code>{AppointmentType}</code></td><td>Type of appointment</td><td>Temple Recommend Interview</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@code {
    private List<Contact> contacts = new();
    private List<Leader> leaders = new();
    private List<AppointmentType> appointmentTypes = new();
    private List<SmsMessage> generatedMessages = new();

    private int? selectedContactId;
    private int? selectedLeaderId;
    private int? selectedAppointmentTypeId;
    private DateTime appointmentDateTime = DateTime.Now.AddDays(1);
    private string testPhoneNumber = "";

    // MudDatePicker.Date is DateTime? and MudTimePicker.Time is TimeSpan?; adapt to the single appointmentDateTime.
    private DateTime? apptDate
    {
        get => appointmentDateTime.Date;
        set => appointmentDateTime = (value?.Date ?? appointmentDateTime.Date) + appointmentDateTime.TimeOfDay;
    }
    private TimeSpan? apptTime
    {
        get => appointmentDateTime.TimeOfDay;
        set => appointmentDateTime = appointmentDateTime.Date + (value ?? appointmentDateTime.TimeOfDay);
    }

    private Contact? selectedContact => selectedContactId.HasValue ? contacts.FirstOrDefault(c => c.Id == selectedContactId.Value) : null;
    private Leader? selectedLeader => selectedLeaderId.HasValue ? leaders.FirstOrDefault(l => l.Id == selectedLeaderId.Value) : null;
    private AppointmentType? selectedAppointmentType => selectedAppointmentTypeId.HasValue ? appointmentTypes.FirstOrDefault(t => t.Id == selectedAppointmentTypeId.Value) : null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var contactDtos = await ContactsApi.GetAllAsync();
        var leaderDtos = await LeadersApi.GetAllAsync();
        var typeDtos = await AppointmentTypesApi.GetAllAsync();

        // SmsService takes Core entities and walks HeadOfHouse / HeadOfHouse.Spouse
        // navigation. Project DTOs back into the entity graph so the service stays unchanged.
        var byId = contactDtos.ToContactGraph();

        contacts = byId.Values
            .Where(c => !string.IsNullOrEmpty(c.PhoneNumber) ||
                        (c.IsMinor && c.HeadOfHouse != null && !string.IsNullOrEmpty(c.HeadOfHouse.PhoneNumber)))
            .OrderBy(c => c.LastName)
            .ThenBy(c => c.FirstName)
            .ToList();

        leaders = leaderDtos
            .Where(l => l.IsActive)
            .Select(l => l.ToLeader())
            .OrderBy(l => l.Title)
            .ToList();

        appointmentTypes = typeDtos
            .Select(t => t.ToAppointmentType())
            .OrderBy(t => t.Name)
            .ToList();
    }

    private void GeneratePreview()
    {
        if (selectedContact == null || selectedLeader == null || selectedAppointmentType == null)
            return;

        var contactsList = new List<Contact> { selectedContact };
        generatedMessages = SmsService.GenerateAppointmentMessages(contactsList, selectedLeader, selectedAppointmentType, appointmentDateTime);
    }

    private async Task CopyToClipboard(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Notifications.ShowSuccess("Copied to clipboard.");
    }

    private async Task OpenSmsLink(string smsLink)
    {
        await JSRuntime.InvokeVoidAsync("open", smsLink, "_blank");
    }
}
