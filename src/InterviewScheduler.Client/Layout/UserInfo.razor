<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.body2" Class="mr-2 d-none d-sm-flex">@context.User.Identity?.Name</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Logout" Href="/signout-google">
            Sign Out
        </MudButton>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   StartIcon="@Icons.Custom.Brands.Google" Href="/signin-google">
            Sign In with Google
        </MudButton>
    </NotAuthorized>
</AuthorizeView>
