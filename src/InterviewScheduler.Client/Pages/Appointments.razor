@page "/appointments"
@attribute [Authorize]
@using InterviewScheduler.Core.Entities
@using InterviewScheduler.Core.Enums
@inject IAppointmentsApiClient AppointmentsApi
@inject IContactsApiClient ContactsApi
@inject ILeadersApiClient LeadersApi
@inject IAppointmentTypesApiClient AppointmentTypesApi
@inject ISmsService SmsService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IAppNotificationService Notifications

<PageTitle>Appointments</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Appointment Management</MudText>

<div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle"
               OnClick='() => Navigation.NavigateTo("/appointments/new")'>
        Schedule New Appointment
    </MudButton>

    <MudToggleGroup T="string" @bind-Value="viewFilter" Color="Color.Primary" Size="Size.Small" CheckMark="false" Outlined="true">
        <MudToggleItem Value="@("all")" Text="@($"All ({appointments.Count})")" />
        <MudToggleItem Value="@("pending")" Text="@($"Pending ({appointments.Count(a => a.Status == AppointmentStatus.Pending)})")" />
        <MudToggleItem Value="@("confirmed")" Text="@($"Confirmed ({appointments.Count(a => a.Status == AppointmentStatus.Confirmed)})")" />
        <MudToggleItem Value="@("cancelled")" Text="@($"Cancelled ({appointments.Count(a => a.Status == AppointmentStatus.Cancelled)})")" />
    </MudToggleGroup>
</div>

<MudGrid Class="mb-2" Spacing="2">
    <MudItem xs="12" md="4">
        <MudTextField @bind-Value="searchTerm" Immediate="true" Placeholder="Search appointments..."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="string" @bind-Value="leaderFilter" Label="Leader" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            <MudSelectItem T="string" Value="@("")">All Leaders</MudSelectItem>
            @foreach (var leader in leaders)
            {
                <MudSelectItem T="string" Value="@leader.Id.ToString()">@leader.Name (@leader.Title)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="string" @bind-Value="dateFilter" Label="Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            <MudSelectItem T="string" Value="@("")">All Dates</MudSelectItem>
            <MudSelectItem T="string" Value="@("today")">Today</MudSelectItem>
            <MudSelectItem T="string" Value="@("week")">This Week</MudSelectItem>
            <MudSelectItem T="string" Value="@("month")">This Month</MudSelectItem>
            <MudSelectItem T="string" Value="@("upcoming")">Upcoming</MudSelectItem>
            <MudSelectItem T="string" Value="@("past")">Past</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" md="2" Class="d-flex align-center">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.FilterAltOff" OnClick="ClearFilters">
            Clear Filters
        </MudButton>
    </MudItem>
</MudGrid>

@if (filteredAppointments.Any())
{
    @foreach (var dayGroup in filteredAppointments.GroupBy(a => a.ScheduledTime.Date).OrderBy(g => g.Key))
    {
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@dayGroup.Key.ToString("dddd, MMMM dd, yyyy")</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                <div class="appointments-table-view">
                    <MudTable Items="dayGroup.OrderBy(a => a.ScheduledTime)" Dense="true" Hover="true" Striped="true" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh>Time</MudTh>
                            <MudTh>Contact</MudTh>
                            <MudTh>Leader</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align:right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Time">
                                <MudText Typo="Typo.body2"><b>@context.ScheduledTime.ToString("h:mm tt")</b></MudText>
                                <MudText Typo="Typo.caption">@context.AppointmentType?.Duration min</MudText>
                            </MudTd>
                            <MudTd DataLabel="Contact">
                                <MudText Typo="Typo.body2"><b>@context.Contact?.FullName</b></MudText>
                                <MudText Typo="Typo.caption">@GetPhoneDisplay(context.Contact)</MudText>
                                @if (context.Contact?.IsMinor == true)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="mt-1">Minor</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Leader">
                                <MudText Typo="Typo.body2"><b>@context.Leader?.Name</b></MudText>
                                <MudText Typo="Typo.caption">@context.Leader?.Title</MudText>
                            </MudTd>
                            <MudTd DataLabel="Type">@context.AppointmentType?.Name</MudTd>
                            <MudTd DataLabel="Status">@StatusChip(context.Status)</MudTd>
                            <MudTd Style="text-align:right">
                                @AppointmentActions(context, "appointment-actions--desktop")
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

                <div class="appointments-mobile-view">
                    @foreach (var appointment in dayGroup.OrderBy(a => a.ScheduledTime))
                    {
                        <article class="appointment-mobile-card">
                            <div class="appointment-mobile-card__header">
                                <div>
                                    <MudText Typo="Typo.subtitle1"><b>@appointment.ScheduledTime.ToString("h:mm tt")</b></MudText>
                                    <MudText Typo="Typo.caption">@appointment.AppointmentType?.Duration min</MudText>
                                </div>
                                @StatusChip(appointment.Status)
                            </div>

                            <div class="appointment-mobile-card__body">
                                <div class="appointment-mobile-card__title-row">
                                    <MudText Typo="Typo.body1"><b>@appointment.Contact?.FullName</b></MudText>
                                    @if (appointment.Contact?.IsMinor == true)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info">Minor</MudChip>
                                    }
                                </div>

                                <dl class="appointment-mobile-card__meta">
                                    <div>
                                        <dt>Type</dt>
                                        <dd>@appointment.AppointmentType?.Name</dd>
                                    </div>
                                    <div>
                                        <dt>Leader</dt>
                                        <dd>@appointment.Leader?.Name<span class="appointment-mobile-card__muted"> @appointment.Leader?.Title</span></dd>
                                    </div>
                                    <div>
                                        <dt>Phone</dt>
                                        <dd>@GetPhoneDisplay(appointment.Contact)</dd>
                                    </div>
                                </dl>
                            </div>

                            @AppointmentActions(appointment, "appointment-actions--mobile")
                        </article>
                    }
                </div>
            </MudCardContent>
        </MudCard>
    }
}
else
{
    <MudPaper Elevation="2" Class="pa-8 d-flex flex-column align-center justify-center" Style="min-height: 240px;">
        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Large" Color="Color.Default" />
        <MudText Typo="Typo.h6" Class="mt-3">No Appointments Found</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-3">
            @if (viewFilter == "all")
            {
                <span>No appointments have been scheduled yet.</span>
            }
            else
            {
                <span>No @viewFilter appointments found. Try adjusting your filters.</span>
            }
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick='() => Navigation.NavigateTo("/appointments/new")'>
            Schedule Your First Appointment
        </MudButton>
    </MudPaper>
}

<MudDialog @bind-Visible="showDetails" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Appointment Details</MudText>
    </TitleContent>
    <DialogContent>
        @if (selectedAppointment != null)
        {
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" GutterBottom="true">Contact Information</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr>
                                <td><b>Name:</b></td>
                                <td>@selectedAppointment.Contact?.FullName</td>
                            </tr>
                            <tr>
                                <td><b>Phone:</b></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(selectedAppointment.Contact?.PhoneNumber))
                                    {
                                        <MudLink Color="Color.Info" OnClick="() => CopyPhoneToClipboard(selectedAppointment.Contact.PhoneNumber)">
                                            @selectedAppointment.Contact.PhoneNumber <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                                        </MudLink>
                                    }
                                    else if (selectedAppointment.Contact?.IsMinor == true && selectedAppointment.Contact?.HeadOfHouse != null)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Default">No direct phone</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Info">SMS will be sent to:</MudText>
                                        @if (!string.IsNullOrEmpty(selectedAppointment.Contact.HeadOfHouse.PhoneNumber))
                                        {
                                            <MudLink Color="Color.Info" OnClick="() => CopyPhoneToClipboard(selectedAppointment.Contact.HeadOfHouse.PhoneNumber!)">
                                                @selectedAppointment.Contact.HeadOfHouse.FirstName: @selectedAppointment.Contact.HeadOfHouse.PhoneNumber
                                            </MudLink>
                                            @if (selectedAppointment.Contact.HeadOfHouse.Spouse != null &&
                                                !string.IsNullOrEmpty(selectedAppointment.Contact.HeadOfHouse.Spouse.PhoneNumber) &&
                                                selectedAppointment.Contact.HeadOfHouse.Spouse.PhoneNumber != selectedAppointment.Contact.HeadOfHouse.PhoneNumber)
                                            {
                                                <text> | </text>
                                                <MudLink Color="Color.Info" OnClick="() => CopyPhoneToClipboard(selectedAppointment.Contact.HeadOfHouse.Spouse.PhoneNumber!)">
                                                    @selectedAppointment.Contact.HeadOfHouse.Spouse.FirstName: @selectedAppointment.Contact.HeadOfHouse.Spouse.PhoneNumber
                                                </MudLink>
                                            }
                                        }
                                        else
                                        {
                                            <text>No parent phone</text>
                                        }
                                    }
                                    else if (selectedAppointment.Contact?.IsMinor == false && selectedAppointment.Contact?.HeadOfHouse != null && !string.IsNullOrEmpty(selectedAppointment.Contact.HeadOfHouse.PhoneNumber))
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Default">No direct phone</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Info">SMS will be sent to head of household:</MudText>
                                        <MudLink Color="Color.Info" OnClick="() => CopyPhoneToClipboard(selectedAppointment.Contact.HeadOfHouse.PhoneNumber!)">
                                            @selectedAppointment.Contact.HeadOfHouse.FirstName: @selectedAppointment.Contact.HeadOfHouse.PhoneNumber
                                        </MudLink>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Default">No phone number</MudText>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><b>Age:</b></td>
                                <td>@selectedAppointment.Contact?.Age @(selectedAppointment.Contact?.IsMinor == true ? "(Minor)" : "")</td>
                            </tr>
                            @if (selectedAppointment.Contact?.HeadOfHouse != null)
                            {
                                <tr>
                                    <td><b>Head of House:</b></td>
                                    <td>@selectedAppointment.Contact.HeadOfHouse.FullName</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle1" GutterBottom="true">Appointment Information</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td><b>Leader:</b></td><td>@selectedAppointment.Leader?.Name (@selectedAppointment.Leader?.Title)</td></tr>
                            <tr><td><b>Type:</b></td><td>@selectedAppointment.AppointmentType?.Name</td></tr>
                            <tr><td><b>Date &amp; Time:</b></td><td>@selectedAppointment.ScheduledTime.ToString("dddd, MMMM dd, yyyy 'at' h:mm tt")</td></tr>
                            <tr><td><b>Duration:</b></td><td>@selectedAppointment.AppointmentType?.Duration minutes</td></tr>
                            <tr><td><b>Status:</b></td><td>@StatusChip(selectedAppointment.Status)</td></tr>
                            <tr><td><b>Created:</b></td><td>@selectedAppointment.CreatedDate.ToString("MMM dd, yyyy 'at' h:mm tt")</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrEmpty(selectedAppointment.AppointmentType?.MessageTemplate))
            {
                <MudText Typo="Typo.subtitle1" GutterBottom="true" Class="mt-4">Message Templates</MudText>
                <MudAlert Severity="Severity.Info" Class="mb-2">
                    <div class="d-flex justify-space-between align-start">
                        <div class="flex-grow-1">
                            <b>@(selectedAppointment.Contact?.IsMinor == true ? "Minor Template (sent to parent):" : "Adult Template:")</b><br />
                            @GetFormattedMessage(selectedAppointment)
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary"
                                       OnClick="() => CopyMessageToClipboard(GetFormattedMessage(selectedAppointment))" />
                    </div>
                </MudAlert>

                @if (selectedAppointment.Contact?.IsMinor == true && !string.IsNullOrEmpty(selectedAppointment.AppointmentType?.MinorMessageTemplate))
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
                        <div class="d-flex justify-space-between align-start">
                            <div class="flex-grow-1">
                                <b>Adult Template (for reference):</b><br />
                                @GetAdultFormattedMessage(selectedAppointment)
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                           OnClick="() => CopyMessageToClipboard(GetAdultFormattedMessage(selectedAppointment))" />
                        </div>
                    </MudAlert>
                }
                else if (selectedAppointment.Contact?.IsMinor == false && !string.IsNullOrEmpty(selectedAppointment.AppointmentType?.MinorMessageTemplate))
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined">
                        <div class="d-flex justify-space-between align-start">
                            <div class="flex-grow-1">
                                <b>Minor Template (for reference):</b><br />
                                @GetMinorFormattedMessage(selectedAppointment)
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                                           OnClick="() => CopyMessageToClipboard(GetMinorFormattedMessage(selectedAppointment))" />
                        </div>
                    </MudAlert>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseDetails">Close</MudButton>
        @if (selectedAppointment?.Status == AppointmentStatus.Pending)
        {
            <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="() => ConfirmAppointment(selectedAppointment)">Confirm Appointment</MudButton>
        }
        @if (selectedAppointment != null && selectedAppointment.Status != AppointmentStatus.Cancelled)
        {
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="() => CancelAppointment(selectedAppointment)">Cancel Appointment</MudButton>
        }
        @if (selectedAppointment?.Status == AppointmentStatus.Cancelled)
        {
            <MudButton Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteAppointment(selectedAppointment)">Delete Appointment</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private List<Appointment> appointments = new();
    private List<Leader> leaders = new();
    private Appointment? selectedAppointment;
    private bool showDetails;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };

    private string viewFilter = "all";
    private string searchTerm = "";
    private string leaderFilter = "";
    private string dateFilter = "upcoming";

    private RenderFragment StatusChip(AppointmentStatus status) =>@<text>
        @switch (status)
        {
            case AppointmentStatus.Pending:
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">Pending</MudChip>
                break;
            case AppointmentStatus.Confirmed:
                <MudChip T="string" Size="Size.Small" Color="Color.Success">Confirmed</MudChip>
                break;
            case AppointmentStatus.Cancelled:
                <MudChip T="string" Size="Size.Small" Color="Color.Error">Cancelled</MudChip>
                break;
        }
    </text>;

    private RenderFragment AppointmentActions(Appointment appointment, string className) =>@<div class="appointment-actions @className">
        @if (appointment.Status == AppointmentStatus.Pending)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Check" OnClick="() => ConfirmAppointment(appointment)">Confirm</MudButton>
        }
        @if (appointment.Status != AppointmentStatus.Cancelled)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Close" OnClick="() => CancelAppointment(appointment)">Cancel</MudButton>
        }
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Visibility" OnClick="() => ViewDetails(appointment)">Details</MudButton>
        @if (HasValidPhoneForSms(appointment))
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Smartphone" OnClick="() => SendSMSReminder(appointment)">SMS @GetSmsButtonLabel(appointment.Contact)</MudButton>
        }
        @if (appointment.Status == AppointmentStatus.Cancelled)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Delete" OnClick="() => DeleteAppointment(appointment)">Delete</MudButton>
        }
    </div>;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        // The API exposes flat DTOs; reassemble the entity graph client-side so the page
        // can keep using Core entity navigation (Contact, Leader, AppointmentType, plus
        // HeadOfHouse / Spouse) and ISmsService unchanged.
        var apptDtosTask = AppointmentsApi.GetAllAsync();
        var contactDtosTask = ContactsApi.GetAllAsync();
        var leaderDtosTask = LeadersApi.GetAllAsync();
        var typeDtosTask = AppointmentTypesApi.GetAllAsync();

        await Task.WhenAll(apptDtosTask, contactDtosTask, leaderDtosTask, typeDtosTask);

        var contactsById = (await contactDtosTask).ToContactGraph();
        var leadersById = (await leaderDtosTask).ToDictionary(l => l.Id, l => l.ToLeader());
        var typesById = (await typeDtosTask).ToDictionary(t => t.Id, t => t.ToAppointmentType());

        appointments = (await apptDtosTask)
            .Select(d => d.ToAppointment(contactsById, leadersById, typesById))
            .Where(a => a != null)
            .Cast<Appointment>()
            .OrderBy(a => a.ScheduledTime)
            .ToList();

        leaders = leadersById.Values
            .Where(l => l.IsActive)
            .OrderBy(l => l.Title)
            .ToList();
    }

    private IEnumerable<Appointment> filteredAppointments
    {
        get
        {
            var filtered = appointments.AsEnumerable();

            if (viewFilter != "all")
            {
                var status = viewFilter switch
                {
                    "pending" => AppointmentStatus.Pending,
                    "confirmed" => AppointmentStatus.Confirmed,
                    "cancelled" => AppointmentStatus.Cancelled,
                    _ => AppointmentStatus.Pending
                };
                filtered = filtered.Where(a => a.Status == status);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                filtered = filtered.Where(a =>
                    (a.Contact?.FirstName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                    (!string.IsNullOrEmpty(a.Contact?.MiddleName) && a.Contact.MiddleName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (a.Contact?.LastName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                    (a.Contact?.PhoneNumber?.Contains(searchTerm) == true) ||
                    (a.Leader?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
                    (a.AppointmentType?.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true));
            }

            if (!string.IsNullOrWhiteSpace(leaderFilter) && int.TryParse(leaderFilter, out var leaderId))
            {
                filtered = filtered.Where(a => a.LeaderId == leaderId);
            }

            if (!string.IsNullOrWhiteSpace(dateFilter))
            {
                var today = DateTime.Today;
                filtered = dateFilter switch
                {
                    "today" => filtered.Where(a => a.ScheduledTime.Date == today),
                    "week" => filtered.Where(a => a.ScheduledTime.Date >= today && a.ScheduledTime.Date <= today.AddDays(7)),
                    "month" => filtered.Where(a => a.ScheduledTime.Date >= today && a.ScheduledTime.Date <= today.AddDays(30)),
                    "upcoming" => filtered.Where(a => a.ScheduledTime.Date >= today),
                    "past" => filtered.Where(a => a.ScheduledTime.Date < today),
                    _ => filtered
                };
            }

            return filtered.OrderBy(a => a.ScheduledTime);
        }
    }

    private void SetFilter(string filter) => viewFilter = filter;

    private void ClearFilters()
    {
        searchTerm = "";
        leaderFilter = "";
        dateFilter = "";
        viewFilter = "all";
    }

    private string GetRowClass(Appointment appointment)
    {
        if (appointment.ScheduledTime.Date < DateTime.Today)
            return "table-secondary";

        if (appointment.Status == AppointmentStatus.Cancelled)
            return "table-danger";

        if (appointment.Status == AppointmentStatus.Confirmed)
            return "table-success";

        return "";
    }

    private async Task ConfirmAppointment(Appointment appointment)
    {
        try
        {
            await AppointmentsApi.ConfirmAsync(appointment.Id);
            await LoadData();
            CloseDetails();
        }
        catch (Exception ex)
        {
            await Notifications.ShowErrorAsync("Confirm Appointment Failed", $"Failed to confirm appointment: {ex.Message}");
        }
    }

    private async Task CancelAppointment(Appointment appointment)
    {
        var confirmed = await Notifications.ConfirmAsync(
            "Cancel Appointment",
            $"Are you sure you want to cancel the appointment with {appointment.Contact?.FullName}?",
            "Cancel Appointment");

        if (!confirmed) return;

        try
        {
            // The server-side cancel handler deletes the Google Calendar event before
            // marking the appointment cancelled, returning 502 if calendar deletion fails.
            await AppointmentsApi.CancelAsync(appointment.Id);
            await LoadData();
            CloseDetails();
        }
        catch (HttpRequestException ex)
        {
            await Notifications.ShowErrorAsync("Cancel Appointment Failed",
                $"Failed to cancel appointment: {ex.Message}. The calendar event may not have been removed.");
        }
    }

    private void ViewDetails(Appointment appointment)
    {
        selectedAppointment = appointment;
        showDetails = true;
    }

    private void CloseDetails()
    {
        selectedAppointment = null;
        showDetails = false;
    }

    private async Task SendSMSReminder(Appointment appointment)
    {
        if (appointment.Contact == null || appointment.AppointmentType == null || appointment.Leader == null)
            return;

        var targetPhoneNumber = appointment.Contact.PhoneNumber;
        var isParentMessage = false;

        if (appointment.Contact.IsMinor && appointment.Contact.HeadOfHouse != null)
        {
            var parentPhoneNumbers = new List<string>();

            if (!string.IsNullOrEmpty(appointment.Contact.HeadOfHouse.PhoneNumber) &&
                appointment.Contact.HeadOfHouse.PhoneNumber != appointment.Contact.PhoneNumber)
            {
                parentPhoneNumbers.Add(appointment.Contact.HeadOfHouse.PhoneNumber);
            }

            if (appointment.Contact.HeadOfHouse.Spouse != null &&
                !string.IsNullOrEmpty(appointment.Contact.HeadOfHouse.Spouse.PhoneNumber) &&
                appointment.Contact.HeadOfHouse.Spouse.PhoneNumber != appointment.Contact.PhoneNumber &&
                !parentPhoneNumbers.Contains(appointment.Contact.HeadOfHouse.Spouse.PhoneNumber))
            {
                parentPhoneNumbers.Add(appointment.Contact.HeadOfHouse.Spouse.PhoneNumber);
            }

            if (parentPhoneNumbers.Any())
            {
                targetPhoneNumber = string.Join(",", parentPhoneNumbers);
                isParentMessage = true;
            }
        }

        if (string.IsNullOrEmpty(targetPhoneNumber) && !appointment.Contact.IsMinor && appointment.Contact.HeadOfHouse != null)
        {
            if (!string.IsNullOrEmpty(appointment.Contact.HeadOfHouse.PhoneNumber))
            {
                targetPhoneNumber = appointment.Contact.HeadOfHouse.PhoneNumber;
            }
        }

        if (string.IsNullOrEmpty(targetPhoneNumber))
            return;

        var message = isParentMessage
            ? SmsService.GenerateParentNotificationMessage(appointment.Contact, appointment.Leader, appointment.AppointmentType, appointment.ScheduledTime)
            : SmsService.FormatMessage(appointment.AppointmentType, appointment.Contact, appointment.Leader, appointment.ScheduledTime);

        var smsUrl = SmsService.GenerateSmsLink(targetPhoneNumber, message);

        await JSRuntime.InvokeVoidAsync("open", smsUrl, "_blank");
    }

    private string GetFormattedMessage(Appointment appointment)
    {
        if (appointment.AppointmentType == null || appointment.Contact == null || appointment.Leader == null)
            return "";

        return SmsService.FormatMessage(appointment.AppointmentType, appointment.Contact, appointment.Leader, appointment.ScheduledTime);
    }

    private string GetAdultFormattedMessage(Appointment appointment)
    {
        if (appointment.AppointmentType == null || appointment.Contact == null || appointment.Leader == null)
            return "";

        var adultContact = new Contact
        {
            FirstName = appointment.Contact.FirstName,
            LastName = appointment.Contact.LastName,
            Gender = appointment.Contact.Gender,
            BirthDate = DateTime.Today.AddYears(-25),
            PhoneNumber = appointment.Contact.PhoneNumber,
            HeadOfHouse = appointment.Contact.HeadOfHouse
        };

        return SmsService.FormatMessage(appointment.AppointmentType, adultContact, appointment.Leader, appointment.ScheduledTime);
    }

    private string GetMinorFormattedMessage(Appointment appointment)
    {
        if (appointment.AppointmentType == null || appointment.Contact == null || appointment.Leader == null)
            return "";

        var minorContact = new Contact
        {
            FirstName = appointment.Contact.FirstName,
            LastName = appointment.Contact.LastName,
            Gender = appointment.Contact.Gender,
            BirthDate = DateTime.Today.AddYears(-16),
            PhoneNumber = appointment.Contact.PhoneNumber,
            HeadOfHouse = appointment.Contact.HeadOfHouse ?? appointment.Contact
        };

        return SmsService.FormatMessage(appointment.AppointmentType, minorContact, appointment.Leader, appointment.ScheduledTime);
    }

    private bool HasValidPhoneForSms(Appointment appointment)
    {
        if (appointment.Contact == null) return false;
        if (!string.IsNullOrEmpty(appointment.Contact.PhoneNumber)) return true;
        if (appointment.Contact.IsMinor && appointment.Contact.HeadOfHouse != null &&
            !string.IsNullOrEmpty(appointment.Contact.HeadOfHouse.PhoneNumber)) return true;
        if (!appointment.Contact.IsMinor && appointment.Contact.HeadOfHouse != null &&
            !string.IsNullOrEmpty(appointment.Contact.HeadOfHouse.PhoneNumber)) return true;
        return false;
    }

    private string GetParentPhoneDisplay(Contact contact)
    {
        if (contact.HeadOfHouse == null)
            return "No parent phone";

        var parentPhones = new List<string>();

        if (!string.IsNullOrEmpty(contact.HeadOfHouse.PhoneNumber))
        {
            parentPhones.Add($"{contact.HeadOfHouse.FirstName}: {contact.HeadOfHouse.PhoneNumber}");
        }

        if (contact.HeadOfHouse.Spouse != null &&
            !string.IsNullOrEmpty(contact.HeadOfHouse.Spouse.PhoneNumber) &&
            contact.HeadOfHouse.Spouse.PhoneNumber != contact.HeadOfHouse.PhoneNumber)
        {
            parentPhones.Add($"{contact.HeadOfHouse.Spouse.FirstName}: {contact.HeadOfHouse.Spouse.PhoneNumber}");
        }

        return parentPhones.Any() ? string.Join(" | ", parentPhones) : "No parent phone";
    }

    private string GetPhoneDisplay(Contact? contact)
    {
        if (contact == null)
            return "No phone";

        if (!string.IsNullOrEmpty(contact.PhoneNumber))
            return contact.PhoneNumber;

        if (contact.IsMinor && contact.HeadOfHouse != null)
            return GetParentPhoneDisplay(contact);

        if (!contact.IsMinor && contact.HeadOfHouse != null && !string.IsNullOrEmpty(contact.HeadOfHouse.PhoneNumber))
            return $"via {contact.HeadOfHouse.FirstName}: {contact.HeadOfHouse.PhoneNumber}";

        return "No phone";
    }

    private string GetSmsButtonLabel(Contact? contact)
    {
        if (contact == null || !contact.IsMinor || contact.HeadOfHouse == null)
            return "";

        var parentCount = 0;

        if (!string.IsNullOrEmpty(contact.HeadOfHouse.PhoneNumber))
            parentCount++;

        if (contact.HeadOfHouse.Spouse != null &&
            !string.IsNullOrEmpty(contact.HeadOfHouse.Spouse.PhoneNumber) &&
            contact.HeadOfHouse.Spouse.PhoneNumber != contact.HeadOfHouse.PhoneNumber)
            parentCount++;

        return parentCount switch
        {
            0 => "",
            1 => "(Parent)",
            _ => "(Both Parents)"
        };
    }

    private async Task DeleteAppointment(Appointment appointment)
    {
        var confirmed = await Notifications.ConfirmAsync(
            "Delete Appointment",
            $"Are you sure you want to permanently delete this appointment with {appointment.Contact?.FullName}?",
            "Delete Appointment");

        if (!confirmed) return;

        try
        {
            await AppointmentsApi.DeleteAsync(appointment.Id);
            await LoadData();
            CloseDetails();
        }
        catch (Exception ex)
        {
            await Notifications.ShowErrorAsync("Delete Appointment Failed", $"Failed to delete appointment: {ex.Message}");
        }
    }

    private async Task CopyPhoneToClipboard(string? phoneNumber)
    {
        if (string.IsNullOrEmpty(phoneNumber)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", phoneNumber);
        Notifications.ShowSuccess("Phone number copied to clipboard.");
    }

    private async Task CopyMessageToClipboard(string message)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", message);
        Notifications.ShowSuccess("Message copied to clipboard.");
    }
}
